# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real secrets.
#
# ---------------------------------------------------------------------------
# Where each variable is actually used:
#
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
#   - LOCAL:   only if you run Postgres yourself outside Docker
#   - DOCKER:  used by docker-compose.yml to initialize the postgres container
#   - AWS:     become the RDS master username/db name; password goes into
#              AWS Secrets Manager / SSM Parameter Store, never in plain text
#   - K8S:     stored in a Kubernetes Secret, referenced by the backend Deployment
#
# DATABASE_URL
#   - Full SQLAlchemy connection string the backend actually connects with.
#   - LOCAL:   postgresql+psycopg2://postgres:postgres@localhost:5432/employee_task_db
#   - DOCKER:  postgresql+psycopg2://postgres:postgres@postgres:5432/employee_task_db
#              (hostname "postgres" = the Compose service name, resolved by
#              Docker's internal DNS on the app network)
#   - AWS/K8S: postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/employee_task_db
#
# API_BASE_URL / VITE_API_BASE_URL
#   - The URL the FRONTEND uses to reach the backend.
#   - LOCAL:   http://localhost:8000
#   - DOCKER:  http://localhost:8000 (browser-facing; containers can't use
#              service names for URLs baked into browser-side JS)
#   - AWS:     https://api.example.com (through the ALB + ACM cert)
#   - K8S:     https://api.example.com (through the Ingress)
#
# ENVIRONMENT
#   - Free-text label used only for logging verbosity: local | docker | production
# ---------------------------------------------------------------------------

POSTGRES_DB=employee_task_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-real-environments

DATABASE_URL=postgresql+psycopg2://postgres:Harekrishna@123@postgres:5432/c

API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

ENVIRONMENT=docker
