# Base URL the frontend uses to reach the backend API.
# Local dev (backend run directly):      http://localhost:8000
# Docker Compose (service name):         http://backend:8000  <- only for server-side; browser needs a reachable host
# Docker Compose (browser-facing):       http://localhost:8000
# Production behind ALB/Nginx:           https://api.example.com
VITE_API_BASE_URL=http://localhost:8000
